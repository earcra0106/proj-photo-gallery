{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.mjs"],
      "cache": false
    },
    "format": {
      "inputs": ["src/**", "prettier.config.mjs"],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "seed": {
      "dependsOn": ["build"],
      "cache": false
    },
    "migrate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".next/**"],
      "cache": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@repo/prisma#build": {
      "dependsOn": ["@repo/prisma#generate"],
      "outputs": ["dist/**"],
      "cache": true
    }
  }
}
